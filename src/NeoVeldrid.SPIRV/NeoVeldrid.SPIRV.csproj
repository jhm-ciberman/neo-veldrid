<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <Description>SPIR-V cross-compilation for NeoVeldrid using Silk.NET. Compiles GLSL to SPIR-V and cross-compiles SPIR-V to HLSL, GLSL, and ESSL.</Description>
        <PackageTags>3D Graphics Direct3D DirectX Vulkan OpenGL Core Game SPIRV Shader</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../NeoVeldrid/NeoVeldrid.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.SPIRV.Cross" />
        <PackageReference Include="Silk.NET.Shaderc" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="$(RootDir)src\Shared\SilkNativeContext.cs" Link="Shared\SilkNativeContext.cs" />
    </ItemGroup>

</Project>
